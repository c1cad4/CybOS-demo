{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cyb Task Envelope v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "task_id",
    "issuer",
    "assignee",
    "capabilities",
    "deadline_ms",
    "budget",
    "input"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "issuer": {
      "type": "string",
      "minLength": 1
    },
    "assignee": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "deadline_ms": {
      "type": "integer",
      "minimum": 0
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_runtime_ms",
        "max_output_bytes"
      ],
      "properties": {
        "max_runtime_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10485760
        }
      }
    },
    "input": {
      "type": "object"
    },
    "evidence_ref": {
      "type": "string"
    }
  }
}
